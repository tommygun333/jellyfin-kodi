<?xml version="1.0" encoding="UTF-8"?>
<!-- Skip Intro/Credits OSD overlay button for Jellyfin -->
<window>
	<defaultcontrol always="true">3012</defaultcontrol>
	<onload>Dialog.Close(fullscreeninfo,true)</onload>
	<controls>
		<control type="group">
			<left>1540</left>
			<top>908</top>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="250"/>
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="fade" start="100" end="0" time="200"/>
			</animation>
			<!-- Single rounded white button, identical to slyguy.skip_intro design -->
			<control type="button" id="3012">
				<label>$INFO[Window.Property(skip_label)]</label>
				<width>300</width>
				<height>72</height>
				<font>font14</font>
				<textcolor>FF000000</textcolor>
				<focusedcolor>FF000000</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<texturenofocus>btn_normal.png</texturenofocus>
				<texturefocus>btn_focus.png</texturefocus>
				<pulseonselect>no</pulseonselect>
			</control>
		</control>
	</controls>
</window>
